rules_version = '2';

// NutCache Firestore security rules.
//
// Deny-all placeholder: there is no NutCache data model yet. Phase 2 replaces this with the real
// household-scoped rules (CLOUD-2, CLOUD-3), tested by the rules suite (AT2.5 in docs/test-plan.md).
// These rules are the production access boundary (SEC-1 in docs/securing_nuts.md), so every change
// here needs a matching rules test.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
